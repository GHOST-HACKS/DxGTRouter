<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0D2B45" />
            <stroke android:width="3dp" android:color="#4488AA" />
            <size android:width="140dp" android:height="140dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#1A4A6E"
                android:endColor="#0A2A3E"
                android:angle="45" />
            <size android:width="130dp" android:height="130dp" />
        </shape>
    </item>
</layer-list>
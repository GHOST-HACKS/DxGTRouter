<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="#0A1A2F">

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="❄️ DxGT GLACIER ROUTER ❄️"
        android:textColor="#B0E0FF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@dxgtsniper"
        android:textColor="#66CCFF"
        android:textSize="14sp"
        android:layout_marginBottom="30dp" />

    <FrameLayout
        android:id="@+id/ringContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/rotatingRing"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:src="@drawable/ice_ring" />

        <ImageView
            android:id="@+id/revolvingGlacier"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/glacier_core" />

        <View
            android:id="@+id/glowOverlay"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/glow_effect"
            android:visibility="gone" />

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/glacier_button_off"
            android:text="OFF\n❄️"
            android:textColor="#88AACC"
            android:textSize="14sp"
            android:gravity="center" />

    </FrameLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ STATUS: IDLE"
        android:textColor="#66CCFF"
        android:textSize="14sp"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/followButton"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:background="#00BFFF"
        android:text="FOLLOW ON TIKTOK"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/snowContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp" />

</LinearLayout>
